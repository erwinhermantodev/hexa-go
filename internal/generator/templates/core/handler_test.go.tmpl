package handler

import (
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/labstack/echo/v4"
	"github.com/stretchr/testify/assert"
)

func Test{{.Model.Name}}Handler_Scaffold(t *testing.T) {
	e := echo.New()
	req := httptest.NewRequest(http.MethodGet, "/api/v1/{{kebab (plural .Model.Name)}}", nil)
	rec := httptest.NewRecorder()
	c := e.NewContext(req, rec)

	// Wire a mock service into New{{.Model.Name}}Handler and exercise the handler here.
	assert.NotNil(t, c)
}
