package {{.PackageName}}

type Service interface {
	Create(req Create{{.Model.Name}}Request) (*{{.Model.Name}}Response, error)
	GetAll() ([]{{.Model.Name}}Response, error)
	GetByID(id uint) (*{{.Model.Name}}Response, error)
	Update(id uint, req Create{{.Model.Name}}Request) (*{{.Model.Name}}Response, error)
	Delete(id uint) error
}

type service struct {
	repo Repository
}

func NewService(repo Repository) Service {
	return &service{repo: repo}
}

func (s *service) Create(req Create{{.Model.Name}}Request) (*{{.Model.Name}}Response, error) {
	m := &{{.Model.Name}}{
{{- range .Model.Fields }}
{{- if ne .Name "ID" }}
		{{.Name}}: req.{{.Name}},
{{- end }}
{{- end }}
	}
	if err := s.repo.Create(m); err != nil {
		return nil, err
	}
	res := m.ToResponse()
	return &res, nil
}

func (s *service) GetAll() ([]{{.Model.Name}}Response, error) {
	items, err := s.repo.GetAll()
	if err != nil {
		return nil, err
	}
	var res []{{.Model.Name}}Response
	for _, item := range items {
		res = append(res, item.ToResponse())
	}
	return res, nil
}

func (s *service) GetByID(id uint) (*{{.Model.Name}}Response, error) {
	item, err := s.repo.GetByID(id)
	if err != nil {
		return nil, err
	}
	res := item.ToResponse()
	return &res, nil
}

func (s *service) Update(id uint, req Create{{.Model.Name}}Request) (*{{.Model.Name}}Response, error) {
	m, err := s.repo.GetByID(id)
	if err != nil {
		return nil, err
	}
{{- range .Model.Fields }}
{{- if ne .Name "ID" }}
	m.{{.Name}} = req.{{.Name}}
{{- end }}
{{- end }}
	if err := s.repo.Update(m); err != nil {
		return nil, err
	}
	res := m.ToResponse()
	return &res, nil
}

func (s *service) Delete(id uint) error {
	return s.repo.Delete(id)
}
